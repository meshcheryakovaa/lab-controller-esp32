{
  "name": "lab-controller-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web interface for the Universal ESP32 Laboratory Controller",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "size": "vite build && ls -l dist/assets",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "uplot": "^1.6.31"
  }
}
